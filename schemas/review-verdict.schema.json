{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review verdict",
  "type": "object",
  "required": ["run_ids", "commits", "findings", "verdict"],
  "additionalProperties": false,
  "properties": {
    "run_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "commits": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["commit", "verdict", "evidence"], "additionalProperties": false, "properties": {
      "commit": {"type": "string", "minLength": 1}, "verdict": {"enum": ["PASS", "FAIL"]},
      "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "text"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1}, "severity": {"enum": ["blocking", "non-blocking"]}, "text": {"type": "string", "minLength": 1}
    }}},
    "verdict": {"enum": ["PASS", "FAIL"]}
  }
}
