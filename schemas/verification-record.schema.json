{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationRecord v1",
  "type": "object",
  "required": ["schema_version", "run_id", "mission", "feature", "work_unit", "attempt", "execution_spec", "execution_receipt", "task", "receipt_git_after", "verification_git_before", "verification_git_after", "commands", "result"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "mission": {"type": "string", "minLength": 1}, "feature": {"type": "string", "minLength": 1}, "work_unit": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1}, "result": {"enum": ["pass", "fail"]},
    "execution_spec": {"$ref": "#/$defs/link"}, "execution_receipt": {"$ref": "#/$defs/link"},
    "task": {"allOf": [{"$ref": "#/$defs/link"}, {"required": ["git_commit"], "properties": {"git_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}}}]},
    "receipt_git_after": {"type": "object"}, "verification_git_before": {"type": "object"}, "verification_git_after": {"type": "object"},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["argv", "started_at", "finished_at", "exit_code", "stdout_sha256", "stderr_sha256"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "started_at": {"type": "string"}, "finished_at": {"type": "string"}, "exit_code": {"type": "integer"}, "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  },
  "$defs": {"link": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
