{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task plan",
  "type": "object",
  "required": ["plan_id", "mission", "verdict", "tasks"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["READY", "BLOCKED"]},
    "blocking_question": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "feature", "title", "category", "size", "review", "seats_to_avoid", "depends_on", "allow_list", "verification", "steps"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1}, "feature": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1},
      "size": {"enum": ["S", "M", "L"]}, "review": {"enum": ["Architect", "code-reviewer"]},
      "seats_to_avoid": {"type": "array", "items": {"type": "string"}}, "depends_on": {"type": "array", "items": {"type": "string"}},
      "allow_list": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "verification": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
      "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }}}
  },
  "if": {"properties": {"verdict": {"enum": ["BLOCKED"]}}, "required": ["verdict"]},
  "then": {"required": ["blocking_question"]}
}
