{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purrfect Harness ExecutionSpec",
  "$defs": {
    "commonProperties": {
      "run_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
      "mission": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
      "work_unit": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
      "role": { "enum": ["brain", "worker"] },
      "feature": { "type": ["string", "null"] },
      "provider": { "enum": ["codex", "claude", "agent", "agy"] },
      "model": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
      "effort": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
      "speed": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
      "repo": { "type": "string", "pattern": "^/(?![\\s\\S]*[\\r\\n])(?:[\\s\\S]*\\S)?$" },
      "base_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
      "attempt": { "type": "integer", "minimum": 1 },
      "prompt": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
    },
    "roleRules": {
      "allOf": [
        { "if": { "properties": { "role": { "const": "worker" } }, "required": ["role"] }, "then": { "properties": { "feature": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" } } } },
        { "if": { "properties": { "role": { "const": "brain" } } }, "then": { "properties": { "feature": { "type": "null" } } } }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "mission", "work_unit", "role", "feature", "provider", "model", "effort", "speed", "repo", "base_commit", "attempt", "prompt"],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "$ref": "#/$defs/commonProperties/run_id" },
        "mission": { "$ref": "#/$defs/commonProperties/mission" },
        "work_unit": { "$ref": "#/$defs/commonProperties/work_unit" },
        "role": { "$ref": "#/$defs/commonProperties/role" },
        "feature": { "$ref": "#/$defs/commonProperties/feature" },
        "provider": { "$ref": "#/$defs/commonProperties/provider" },
        "model": { "$ref": "#/$defs/commonProperties/model" },
        "effort": { "$ref": "#/$defs/commonProperties/effort" },
        "speed": { "$ref": "#/$defs/commonProperties/speed" },
        "repo": { "$ref": "#/$defs/commonProperties/repo" },
        "base_commit": { "$ref": "#/$defs/commonProperties/base_commit" },
        "attempt": { "$ref": "#/$defs/commonProperties/attempt" },
        "prompt": { "$ref": "#/$defs/commonProperties/prompt" }
      },
      "allOf": [{ "$ref": "#/$defs/roleRules" }]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "mission", "work_unit", "role", "feature", "provider", "model", "effort", "speed", "repo", "base_commit", "attempt", "prompt", "write_scope"],
      "properties": {
        "schema_version": { "const": 2 },
        "run_id": { "$ref": "#/$defs/commonProperties/run_id" },
        "mission": { "$ref": "#/$defs/commonProperties/mission" },
        "work_unit": { "$ref": "#/$defs/commonProperties/work_unit" },
        "role": { "$ref": "#/$defs/commonProperties/role" },
        "feature": { "$ref": "#/$defs/commonProperties/feature" },
        "provider": { "$ref": "#/$defs/commonProperties/provider" },
        "model": { "$ref": "#/$defs/commonProperties/model" },
        "effort": { "$ref": "#/$defs/commonProperties/effort" },
        "speed": { "$ref": "#/$defs/commonProperties/speed" },
        "repo": { "$ref": "#/$defs/commonProperties/repo" },
        "base_commit": { "$ref": "#/$defs/commonProperties/base_commit" },
        "attempt": { "$ref": "#/$defs/commonProperties/attempt" },
        "prompt": { "$ref": "#/$defs/commonProperties/prompt" },
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!\\.git(?:/|$))(?!\\.tasks(?:/|$))[^\\\\\\r\\n]+$" }
        }
      },
      "allOf": [{ "$ref": "#/$defs/roleRules" }]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "mission", "work_unit", "role", "feature", "provider", "model", "effort", "speed", "repo", "base_commit", "attempt", "prompt", "write_scope", "provider_contract_version"],
      "properties": {
        "schema_version": { "const": 3 },
        "run_id": { "$ref": "#/$defs/commonProperties/run_id" },
        "mission": { "$ref": "#/$defs/commonProperties/mission" },
        "work_unit": { "$ref": "#/$defs/commonProperties/work_unit" },
        "role": { "$ref": "#/$defs/commonProperties/role" },
        "feature": { "$ref": "#/$defs/commonProperties/feature" },
        "provider": { "$ref": "#/$defs/commonProperties/provider" },
        "model": { "$ref": "#/$defs/commonProperties/model" },
        "effort": { "$ref": "#/$defs/commonProperties/effort" },
        "speed": { "$ref": "#/$defs/commonProperties/speed" },
        "repo": { "$ref": "#/$defs/commonProperties/repo" },
        "base_commit": { "$ref": "#/$defs/commonProperties/base_commit" },
        "attempt": { "$ref": "#/$defs/commonProperties/attempt" },
        "prompt": { "$ref": "#/$defs/commonProperties/prompt" },
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!\\.git(?:/|$))(?!\\.tasks(?:/|$))[^\\\\\\r\\n]+$" }
        },
        "provider_contract_version": { "enum": [2, 3, 4, 5, 6, 7, 8, 9] }
      },
      "allOf": [{ "$ref": "#/$defs/roleRules" }]
    }
  ]
}
