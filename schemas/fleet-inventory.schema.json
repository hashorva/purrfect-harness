{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["schema_version","probed_at","providers","last_good","seats"],
  "properties":{"schema_version":{"const":1},"probed_at":{"$ref":"#/$defs/timestamp"},"providers":{"$ref":"#/$defs/providers"},"last_good":{"$ref":"#/$defs/lastGood"},"seats":{"$ref":"#/$defs/seats"}},
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":".*\\S.*"},
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "models":{"type":"array","items":{"$ref":"#/$defs/text"}},
    "family":{"type":"string","pattern":"^[a-z][a-z0-9._-]*$"},
    "caps":{"type":"object","additionalProperties":false,"required":["efforts","speeds"],"properties":{"efforts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"speeds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}}}},
    "success":{"type":"object","additionalProperties":false,"required":["probed_at","capabilities","status","path","aliases","observed_models"],"properties":{"probed_at":{"$ref":"#/$defs/timestamp"},"capabilities":{"$ref":"#/$defs/caps"},"status":{"const":"success"},"path":{"$ref":"#/$defs/text"},"aliases":{"$ref":"#/$defs/models"},"observed_models":{"$ref":"#/$defs/models"}},"anyOf":[{"properties":{"aliases":{"minItems":1}}},{"properties":{"observed_models":{"minItems":1}}}]},
    "failure":{"type":"object","additionalProperties":false,"required":["probed_at","capabilities","status","path","error"],"properties":{"probed_at":{"$ref":"#/$defs/timestamp"},"capabilities":{"$ref":"#/$defs/caps"},"status":{"const":"failure"},"path":{"$ref":"#/$defs/text"},"error":{"$ref":"#/$defs/text"}}},
    "unavailable":{"type":"object","additionalProperties":false,"required":["probed_at","capabilities","status","error"],"properties":{"probed_at":{"$ref":"#/$defs/timestamp"},"capabilities":{"$ref":"#/$defs/caps"},"status":{"const":"unavailable"},"error":{"$ref":"#/$defs/text"}}},
    "provider":{"oneOf":[{"$ref":"#/$defs/success"},{"$ref":"#/$defs/failure"},{"$ref":"#/$defs/unavailable"}]},
    "claudeProvider":{"allOf":[{"$ref":"#/$defs/provider"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh","max"],"speeds":["unknown"]}}}}]},
    "codexProvider":{"allOf":[{"$ref":"#/$defs/provider"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh"],"speeds":["unknown"]}}}}]},
    "agentProvider":{"allOf":[{"$ref":"#/$defs/provider"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh"],"speeds":["standard","fast"]}}}}]},
    "agyProvider":{"allOf":[{"$ref":"#/$defs/provider"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high"],"speeds":["unknown"]}}}}]},
    "claudeSuccess":{"allOf":[{"$ref":"#/$defs/success"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh","max"],"speeds":["unknown"]}}}}]},
    "codexSuccess":{"allOf":[{"$ref":"#/$defs/success"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh"],"speeds":["unknown"]}}}}]},
    "agentSuccess":{"allOf":[{"$ref":"#/$defs/success"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh"],"speeds":["standard","fast"]}}}}]},
    "agySuccess":{"allOf":[{"$ref":"#/$defs/success"},{"properties":{"capabilities":{"const":{"efforts":["low","medium","high"],"speeds":["unknown"]}}}}]},
    "providers":{"type":"object","additionalProperties":false,"required":["claude","codex","agent","agy"],"properties":{"claude":{"$ref":"#/$defs/claudeProvider"},"codex":{"$ref":"#/$defs/codexProvider"},"agent":{"$ref":"#/$defs/agentProvider"},"agy":{"$ref":"#/$defs/agyProvider"}}},
    "lastGood":{"type":"object","additionalProperties":false,"properties":{"claude":{"$ref":"#/$defs/claudeSuccess"},"codex":{"$ref":"#/$defs/codexSuccess"},"agent":{"$ref":"#/$defs/agentSuccess"},"agy":{"$ref":"#/$defs/agySuccess"}}},
    "seat":{"type":"object","additionalProperties":false,"required":["provider","model","family","health","source","capabilities"],"properties":{"provider":{"enum":["claude","codex","agent","agy"]},"model":{"$ref":"#/$defs/text"},"family":{"$ref":"#/$defs/family"},"health":{"enum":["healthy","degraded","unknown"]},"source":{"enum":["observed","alias","last_good","fallback","unavailable"]},"capabilities":{"$ref":"#/$defs/caps"},"unlisted":{"$ref":"#/$defs/models"}},"allOf":[{"if":{"properties":{"provider":{"const":"claude"}}},"then":{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh","max"],"speeds":["unknown"]}}}}},{"if":{"properties":{"provider":{"const":"codex"}}},"then":{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh"],"speeds":["unknown"]}}}}},{"if":{"properties":{"provider":{"const":"agent"}}},"then":{"properties":{"capabilities":{"const":{"efforts":["low","medium","high","xhigh"],"speeds":["standard","fast"]}}}}},{"if":{"properties":{"provider":{"const":"agy"}}},"then":{"properties":{"capabilities":{"const":{"efforts":["low","medium","high"],"speeds":["unknown"]}}}}},{"if":{"properties":{"source":{"enum":["observed","alias"]}}},"then":{"properties":{"health":{"const":"healthy"}}}},{"if":{"properties":{"source":{"enum":["last_good","fallback"]}}},"then":{"properties":{"health":{"const":"degraded"}}}},{"if":{"properties":{"source":{"const":"unavailable"}}},"then":{"properties":{"health":{"const":"unknown"},"model":{"const":"unavailable"}}}},{"if":{"properties":{"source":{"const":"alias"}}},"then":{"properties":{"provider":{"const":"claude"}}}},{"if":{"properties":{"source":{"const":"observed"}}},"then":{"properties":{"provider":{"enum":["codex","agent","agy"]}}}}]},
    "seats":{"type":"object","additionalProperties":false,"required":["brain","brain_fable","brain_codex","cursor.premium","cursor.economy","codex.premium","codex.economy","agy.premium","agy.economy","claude.premium","claude.economy"],"properties":{"brain":{"$ref":"#/$defs/brain"},"brain_fable":{"$ref":"#/$defs/brainFable"},"brain_codex":{"$ref":"#/$defs/brainCodex"},"cursor.premium":{"$ref":"#/$defs/cursorPremium"},"cursor.economy":{"$ref":"#/$defs/cursorEconomy"},"codex.premium":{"$ref":"#/$defs/codexPremium"},"codex.economy":{"$ref":"#/$defs/codexEconomy"},"agy.premium":{"$ref":"#/$defs/agyPremium"},"agy.economy":{"$ref":"#/$defs/agyEconomy"},"claude.premium":{"$ref":"#/$defs/claudePremium"},"claude.economy":{"$ref":"#/$defs/claudeEconomy"}}},
    "brain":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"claude"}}}]},"brainFable":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"claude"}}}]},"brainCodex":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"codex"}}}]},"cursorPremium":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"agent"}}}]},"cursorEconomy":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"agent"}}}]},"codexPremium":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"codex"}}}]},"codexEconomy":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"codex"}}}]},"agyPremium":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"agy"}}}]},"agyEconomy":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"agy"}}}]},"claudePremium":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"claude"}}}]},"claudeEconomy":{"allOf":[{"$ref":"#/$defs/seat"},{"properties":{"provider":{"const":"claude"}}}]}
  }
}
