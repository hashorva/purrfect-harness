{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(supabase migration list*)",
      "Bash(supabase db push --dry-run*)",
      "Bash(tail*)",
      "Bash(mkdir -p .tasks*)",
      "Bash(bash scripts/active-mission.sh*)",
      "Bash(bash scripts/fleet-inventory.sh*)",
      "Bash(bash scripts/spawn-worker.sh*)",
      "Bash(bash scripts/spawn-brain.sh*)",
      "Bash(bash scripts/verify-mission.sh*)",
      "Bash(bash tests/run-tests.sh*)",
      "Bash(shellcheck *)",
      "Bash(codex exec*)",
      "Bash(cursor-agent -p*)",
      "Bash(agy models*)",
      "Bash(agy --dangerously-skip-permissions*)",
      "Bash(claude -p*)",
      "Bash(python3 -c import json*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(supabase db reset*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(.env*)",
      "Read(**/.dev.vars)",
      "Read(**/secrets*)"
    ]
  }
}
