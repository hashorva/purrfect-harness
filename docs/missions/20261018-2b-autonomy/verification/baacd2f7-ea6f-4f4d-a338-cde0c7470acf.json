{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import json, os, pathlib, subprocess, sys, tempfile\nenv = dict(os.environ, PYTHONDONTWRITEBYTECODE='1')\ntmp = pathlib.Path(tempfile.mkdtemp())\ndef fleet(version, seat, effort):\n    path = tmp / ('v%d-%s-%s.json' % (version, seat, effort))\n    path.write_text(json.dumps({'schema_version': version, 'seats': {seat: {'effort': effort}}}), encoding='utf-8')\n    return str(path)\ndef run(*args):\n    out = subprocess.run([sys.executable, 'scripts/dispatch_policy.py', 'validate-role-effort', *args], capture_output=True, text=True, env=env)\n    return out.returncode, out.stderr\nassert run('--role', 'planning', '--effort', 'high') == (0, '')\ncode, err = run('--role', 'planning', '--effort', 'medium')\nassert code == 1 and 'ERROR: planning runs need effort high; got medium' in err, (code, err)\nassert run('--role', 'review', '--effort', 'medium', '--fleet', fleet(2, 'brain', 'medium'), '--seat', 'brain') == (0, '')\ncode, err = run('--role', 'review', '--effort', 'high', '--fleet', fleet(2, 'brain', 'high'), '--seat', 'brain')\nassert code == 1 and 'ERROR: review runs need a seat frozen at effort medium; brain is frozen at high' in err, (code, err)\nassert run('--role', 'worker', '--effort', 'medium', '--fleet', fleet(2, 'codex.economy', 'medium'), '--seat', 'codex.economy') == (0, '')\ncode, err = run('--role', 'worker', '--effort', 'high', '--fleet', fleet(2, 'cursor.premium', 'high'), '--seat', 'cursor.premium')\nassert code == 1 and 'ERROR: worker runs need a seat frozen at effort medium; cursor.premium is frozen at high' in err, (code, err)\nassert run('--role', 'worker', '--effort', 'high', '--fleet', fleet(1, 'agy.premium', 'high'), '--seat', 'agy.premium') == (0, '')\nfor args in (('--role', 'review', '--effort', 'medium'), ('--role', 'worker', '--effort', 'medium', '--fleet', str(tmp / 'missing.json'), '--seat', 'x'), ('--role', 'worker', '--effort', 'medium', '--fleet', fleet(2, 'codex.economy', 'medium'), '--seat', 'claude.economy')):\n    code, err = run(*args)\n    assert code == 1 and err.startswith('ERROR: '), (args, code, err)\nreal = 'docs/missions/20261018-2b-autonomy/fleet.json'\nfor seat in ('agy.premium', 'claude.premium', 'codex.premium', 'cursor.premium'):\n    assert run('--role', 'worker', '--effort', 'medium', '--fleet', real, '--seat', seat) == (0, ''), seat\ncode, err = run('--role', 'review', '--effort', 'high', '--fleet', real, '--seat', 'brain')\nassert code == 1 and 'brain is frozen at high' in err, (code, err)\nfor script in ('scripts/spawn-brain.sh', 'scripts/spawn-worker.sh'):\n    text = pathlib.Path(script).read_text(encoding='utf-8')\n    gate = text.index('validate-role-effort')\n    assert gate < text.index('acquire-lock') and gate < text.index('scripts/execution_spec.py'), script\nprint('ok')"],"exit_code":0,"finished_at":"2026-10-18T20:37:21.262351Z","started_at":"2026-10-18T20:37:20.367957Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-execution-integration.py","WrapperIntegration.test_effort_by_role_is_refused_before_any_spec"],"exit_code":0,"finished_at":"2026-10-18T20:37:22.466278Z","started_at":"2026-10-18T20:37:21.262410Z","stderr_sha256":"2a82dcc60f5c9d379ccf3561b0d12e0060e965cb56287bc82a2dbdff0c9110ca","stdout_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-execution-integration.py","WrapperIntegration.test_v2_brain_never_resolves_to_agy_opus"],"exit_code":0,"finished_at":"2026-10-18T20:37:24.103231Z","started_at":"2026-10-18T20:37:22.466332Z","stderr_sha256":"4d9c24f6708365dbda3ba3294fb41abaccc6586ee27be302caf44cb33acb8769","stdout_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"argv":["env"