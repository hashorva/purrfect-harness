{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import glob, sys\nsys.path.insert(0, \"scripts\")\nimport brain_prompt as B, replay_seeded_defects as R\nBAD = (\"delegat\", \"excerpts you need\", \"cheap subagent\", \"log tail\", \"stream full transcripts\", \"before you finish\", \"stay within it by\")\nflat = lambda s: \" \".join(s.split())\ntexts = {f\"brain {a} {p}\": B.render(a, \"m\", p, \"run.log\") for a in B.ROLES for p in B.PROVIDERS}\ntexts.update({f\"review {p}\": R.review_prompt({\"task\": \"T-043\"}, p) for p in B.PROVIDERS})\nworker = [line for line in open(\"scripts/spawn-worker.sh\", encoding=\"utf-8\") if line.startswith(\"PROMPT=\")]\nassert len(worker) == 1, worker\ntexts[\"worker\"] = worker[0]\nfor path in sorted(glob.glob(\".agents/skills/*/SKILL.md\")) + sorted(glob.glob(\".claude/agents/*.md\")):\n    texts[path] = open(path, encoding=\"utf-8\").read()\nhits = sorted((name, bad) for name, text in texts.items() for bad in BAD if bad in flat(text).lower())\nassert not hits, (len(hits), hits[:4])\nfor a in B.ROLES:\n    text = B.render(a, \"m\", \"claude\")\n    assert \"\\n## Permissions\\n\" in text, a\n    assert \".claude/agents/explorer.md\" in text.split(\"## Resources\", 1)[1].split(\"## Budget\", 1)[0], a\nP = \"The harness defines goals, budgets, permissions and deterministic checks; the model decides its own method.\"\nfor doc in (\"AGENTS.md\", \"docs/missions/ORCHESTRATION.md\"):\n    assert P in flat(open(doc, encoding=\"utf-8\").read()), doc\nprint(\"ok\")\n"],"exit_code":0,"finished_at":"2026-10-19T10:10:01.089062Z","started_at":"2026-10-19T10:10:01.025205Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-goal-style.py"],"exit_code":0,"finished_at":"2026-10-19T10:10:01.154037Z","started_at":"2026-10-19T10:10:01.08