{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import json, subprocess, sys\nsys.path.insert(0, 'scripts')\nimport brain_prompt as B\nM, LOG = 'docs/missions/x', '.tasks/logs/x.log'\nHEADS = ['## Goal', '## Resources', '## Budget', '## Acceptance checks']\nBUDGET = {'planning': 1000000, 'gate': 1000000, 'review': 400000}\nfor action, role in (('mission-init', 'planning'), ('planning', 'planning'), ('gate0', 'gate'), ('gate', 'gate'), ('review', 'review')):\n    for provider in ('claude', 'codex', 'agent', 'agy'):\n        p = B.render(action, M, provider, LOG)\n        lines = p.splitlines()\n        assert lines[0] == 'You are the mission BRAIN for docs/missions/x. Role: ' + role + '.', lines[0]\n        assert [lines.count(h) for h in HEADS] == [1, 1, 1, 1], (action, provider)\n        at = [lines.index(h) for h in HEADS]\n        assert at == sorted(at), (action, provider, at)\n        budget = ' '.join(lines[at[2] + 1:at[3]])\n        assert str(BUDGET[role]) + ' tokens' in budget and 'delegating reading and searching' in budget, budget\n        assert all(str(n) not in budget for n in set(BUDGET.values()) - {BUDGET[role]}), budget\n        assert 'Your log: ' + LOG + '.' in budget, budget\n        assert 'bash scripts/verify-mission.sh docs/missions/x' in ' '.join(lines[at[3] + 1:]), p\n        low = p.lower()\n        if provider == 'claude':\n            assert '.claude/agents/explorer.md' in p and 'model haiku' in low and 'to the explorer subagent' in budget, p\n        else:\n            assert [w for w in ('explorer', 'luna', 'composer', 'flash', 'haiku', '.claude/agents', 'code-reviewer') if w in low] == [], (provider, p)\nassert 'Your log' not in B.render('review', M, 'claude')\nfor bad in (('bogus', M, 'claude'), ('review', M, 'cursor'), ('review', M, 'gpt')):\n    try:\n        B.render(*bad)\n    except ValueError:\n        continue\n    raise SystemExit('accepted %r' % (bad,))\ncli = subprocess.run([sys.executable, 'scripts/brain_prompt.py', 'review', M, '--provider', 'claude', '--log', LOG], capture_output=True, text=True)\nassert (cli.returncode, cli.stdout, cli.stderr) == (0, B.render('review', M, 'claude', LOG) + chr(10), ''), cli\nbad = subprocess.run([sys.executable, 'scripts/brain_prompt.py', 'bogus', M, '--provider', 'claude'], capture_output=True, text=True)\nassert (bad.returncode, bad.stdout) == (2, '') and bad.stderr.startswith('brain_prompt: '), bad\nsh = open('scripts/spawn-brain.sh').read()\nassert '/scripts/brain_prompt.py' in sh and 'Goal for mission-init' not in sh and 'Budget: this one run' not in sh, 'spawn-brain.sh still builds its own prompt'\nown = json.load(open('harness-manifest.json'))['ownership']\nassert [own[k].count('scripts/brain_prompt.py') for k in ('install_payload_paths', 'update_paths')] == [1, 1], 'manifest'\nfor f in ('tests/test-execution-integration.py', 'tests/test-execution-receipt.py'):\n    assert open(f).read().count(chr(34) + 'brain_prompt.py' + chr(34)) == 1, f\nprint('ok')"],"exit_code":0,"finished_at":"2026-10-18T21:27:16.331840Z","started_at":"2026-10-18T21:27:16.237300Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-brain-prompt.py","BrainPromptTests.test_every_role_has_the_four_headings_in_order"],"exit_code":0,"finished_at":"2026-10-18T21:27:16.370915Z","started_at":"2026-10-18T21:27:16.331909Z","stderr_sha256":"fb184ea57734512b1f088f9181209901b9cd46df3eb7eaa2500ea9e48dde20b5","stdout_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-brain-prompt.py","BrainPromptTests.test_budget_states_the_role_budget_and_delegation"],"exit_code":0,"finished_at":"2026-10-18T21:27:16.409461Z","started_at":"2026-10-18T21:27:16.370987Z","stderr_sha256":"fb184ea57734512b