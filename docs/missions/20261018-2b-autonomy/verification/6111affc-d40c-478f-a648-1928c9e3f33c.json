{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import copy, json, sys\nsys.path.insert(0, \"scripts\")\nimport ledger as L\nrow = json.load(open(\"tests/fixtures/ledger/good-completed.json\", encoding=\"utf-8\"))\nL.validate_row(row)\nfor key in (\"tokens_total\", \"tokens_without_cache\", \"tokens_cache_write\", \"role_tag\", \"prompt_version\"):\n    assert key in L.FIELDS and key in L.OPTIONAL_FIELDS, key\nnew = copy.deepcopy(row)\nnew.update(tokens_total={\"value\": 1771684, \"source\": \"observed\"}, tokens_without_cache={\"value\": 87968, \"source\": \"observed\"}, tokens_cache_write={\"value\": None, \"source\": \"unknown\"}, role_tag=\"plan\", prompt_version=\"scripts/brain_prompt.py:0123456789ab\")\nL.validate_row(new)\nnone = copy.deepcopy(new); none[\"prompt_version\"] = None\nL.validate_row(none)\nfor key, bad in ((\"role_tag\", \"boss\"), (\"prompt_version\", \"x\" * 300), (\"prompt_version\", \"/Users/x\"), (\"tokens_total\", 5)):\n    b = copy.deepcopy(new); b[key] = bad\n    try:\n        L.validate_row(b)\n    except L.LedgerError:\n        pass\n    else:\n        raise SystemExit(\"accepted %s=%r\" % (key, bad))\ntext = json.dumps(json.load(open(\"schemas/ledger-row.schema.json\", encoding=\"utf-8\")))\nassert all(k in text for k in (\"tokens_total\", \"tokens_without_cache\", \"tokens_cache_write\", \"role_tag\", \"prompt_version\")), \"schema\"\nprint(\"ok\")\n"],"exit_code":0,"finished_at":"2026-10-19T21:45:05.238019Z","started_at":"2026-10-19T21:45:05.197330Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-ledger.py"],"exit_code":0,"finished_at":"2026-10-19T21:45:25.256728Z","started_at":"2026-10-19T21:45:05.238074Z","stderr_sha256":"02cc6f192672cdbca5ee80783f06df1cde2393e04d136bf5d4fe7c090835e52f","stdout_sha256":"e3b0c44298