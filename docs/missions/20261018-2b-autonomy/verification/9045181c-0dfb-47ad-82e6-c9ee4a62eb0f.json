{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import sys\nsys.path.insert(0, \"scripts\")\nimport brain_prompt as B, replay_seeded_defects as R\nassert not hasattr(B, \"BUDGETS\")\nfor action in B.ROLES:\n    for provider in B.PROVIDERS:\n        text = B.render(action, \"m\", provider, \"run.log\")\n        assert \"budget\" not in text.lower() and \"tokens\" not in text.lower(), (action, provider)\n        heads = [line for line in text.splitlines() if line.startswith(\"## \")]\n        assert heads == [\"## Goal\", \"## Resources\", \"## Permissions\", \"## Acceptance checks\"], heads\n        resources = text.split(\"## Resources\\n\", 1)[1].split(\"\\n## Permissions\", 1)[0]\n        assert resources.endswith(\" Your log: run.log.\"), resources\nfor provider in B.PROVIDERS:\n    assert \"budget\" not in R.review_prompt({\"task\": \"T-043\"}, provider).lower(), provider\nlines = [line for line in open(\"scripts/spawn-worker.sh\", encoding=\"utf-8\").read().splitlines() if line.startswith(\"PROMPT=\")]\nassert len(lines) == 1 and \"budget\" not in lines[0].lower(), lines\nassert \"Permissions: the task's allow-list, max_attempts and long-command rule; PROGRESS.md and features.json belong to the Front Desk.\" in lines[0], lines[0]\nprinciple = \"The harness defines goals, permissions and deterministic checks; the model decides its own method.\"\nfor path in (\"AGENTS.md\", \"docs/missions/ORCHESTRATION.md\"):\n    text = \" \".join(open(path, encoding=\"utf-8\").read().split())\n    assert principle in text and \"token budget, permissions\" not in text, path\nprint(\"ok\")\n"],"exit_code":0,"finished_at":"2026-10-19T16:56:44.700684Z","started_at":"2026-10-19T16:56:44.639534Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-brain-prompt.py"],"exit