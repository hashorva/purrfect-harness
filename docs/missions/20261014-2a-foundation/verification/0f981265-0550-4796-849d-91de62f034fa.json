{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import os, pathlib, subprocess, sys, tempfile\nhp = pathlib.Path('scripts/harness-path.sh')\nassert hp.is_file(), 'missing scripts/harness-path.sh'\nenv_base = {k: v for k, v in os.environ.items() if k != 'HARNESS_PATH_DIRS'}\nout = subprocess.check_output(['/bin/bash', '-c', 'set -euo pipefail; PATH=/usr/bin:/bin; . scripts/harness-path.sh; . scripts/harness-path.sh; printf \"%s\" \"$PATH\"'], text=True, env=env_base)\nparts = out.split(':')\nfor d in ('/opt/homebrew/bin', '/usr/local/bin'):\n    if pathlib.Path(d).is_dir():\n        assert parts.count(d) == 1 and parts.index(d) < parts.index('/usr/bin'), (d, parts)\nout_u = subprocess.check_output(['/bin/bash', '-c', 'set -euo pipefail; unset PATH; . scripts/harness-path.sh; printf \"%s\" \"$PATH\"'], text=True, env=env_base)\nassert out_u, 'empty PATH after unset PATH under set -u'\nwith tempfile.TemporaryDirectory() as tmp:\n    root = pathlib.Path(tmp)\n    tools = root / 'tools'; brew = root / 'brew'; tools.mkdir(); brew.mkdir()\n    (tools / 'python3').symlink_to(sys.executable)\n    for t in ('git', 'jq'):\n        p = tools / t; p.write_text('#!/bin/sh\\nexit 0\\n'); p.chmod(0o755)\n    for t in ('tmux', 'shellcheck'):\n        p = brew / t; p.write_text('#!/bin/sh\\nexit 0\\n'); p.chmod(0o755)\n    for t in ('git', 'python3', 'tmux', 'jq', 'shellcheck'):\n        target = (brew / t) if (brew / t).exists() else (tools / t)\n        saved = target.read_bytes() if not target.is_symlink() else None\n        target.unlink()\n        r = subprocess.run(['/bin/bash', 'scripts/fleet-doctor.sh'], text=True, capture_output=True, env={'PATH': str(tools), 'HARNESS_PATH_DIRS': str(brew), 'PYTHONDONTWRITEBYTECODE': '1'})\n        if saved is None:\n            target.symlink_to(sys.executable)\n        else:\n            target.write_bytes(saved); target.chmod(0o755)\n        assert r.returncode != 0 and f'ERROR {t}:' in (r.stdout + r.stderr), (t, r.returncode, r.stdout, r.stderr)\nprint('ok')"],"exit_code":0,"finished_at":"2026-10-17T19:42:24.239206Z","started_at":"2026-10-17T19:42:24.173432Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-fleet-doctor.py","FleetDoctorTests.test_harness_path_prepends_once_without_duplicates_and_under_set_u"],"exit_code":0,"finished_at":"2026-10-17T19:42:24.296084Z","started_at":"2026-10-17T19:42:24.239263Z","stderr_sha256":"a75d5a91a411eeced9e6131248a85982b358c592dc17ed1f73ccacc7565157fc","stdout_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-fleet-doctor.py","FleetDoctorTests.test_gate0_requires_git_python3_tmux_jq_and_shellcheck"],"exit_code":0,"finished_at":"2026-10-17T19:42:24.392170Z","started_at":"2026-10-17T19:42:24.296148Z","stderr_sha256":"d0f1e19a9fc2c6be1d6fe29c0bad01f1e99e75f01cc9cf013d7dc82a760babb7","stdout_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-fleet-doctor.py"],"exit_code":0,"finished_at":"2026-10-17T19:42:26.539190Z","started_at":"2026-10-17T19:42:24.392220Z","stderr_sha256":"8d10c4d29156d75e48bb6af3b7035b150e94d836c2c466154bdb456e9b122303","stdout_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","bash","tests/test-drive-cli.sh"],"exit_code":0,"finished_at":"2026-10-17T19:42:34.180374Z","started_at":"2026-10-17T19:42:26.539265Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"7b2cd8b06ec8188e64a9e933d39eafab6300d49d9ac249ca64ae8574b0880e8c"},{"argv":["bash","-c","shellcheck scripts/*.sh tests/*.sh"],"exit_code":0,"finished_at":"2026-10-17T19:42:35.075627