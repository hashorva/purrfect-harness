{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import copy, json, os, sys, tempfile\nsys.path.insert(0, \"scripts\")\nimport harness_registry as H\nimport fleet_state as F\nreg = H.load_registry()\nmodels = [\"gemini-3.8-flash-high\", \"gemini-4-argon-high\", \"gemini-5-nova-high\"]\nassert F.choose(models, reg[\"seat_specs\"][\"agy.premium\"][1:]) == \"gemini-4-argon-high\"\nassert \"gemini-5-nova-high\" in F.unlisted_models(models, [\"argon\", \"flash\"])\nassert F.choose([\"gemini-4-argonx-high\"], \"argon\") is None\nfor bad in ([\"agy\", \"argon\", \"argon\"], [\"agy\", \"Nova!\"], [\"agy\"]):\n    b = copy.deepcopy(reg); b[\"seat_specs\"][\"agy.premium\"] = bad\n    try:\n        H.validate_registry(b)\n    except H.RegistryError:\n        pass\n    else:\n        raise AssertionError(f\"accepted {bad}\")\nschema = json.load(open(\"schemas/fleet-inventory.schema.json\"))\nassert schema[\"$defs\"][\"family\"][\"pattern\"] == \"^[a-z][a-z0-9._-]*$\"\nassert \"family\" not in schema[\"$defs\"][\"agyPremium\"][\"allOf\"][1][\"properties\"]\nwith tempfile.TemporaryDirectory() as d:\n    reg2 = copy.deepcopy(reg); reg2[\"seat_specs\"][\"agy.premium\"] = [\"agy\", \"nova\", \"argon\"]\n    assert H.validate_registry(reg2) is reg2\n    assert F.choose(models, reg2[\"seat_specs\"][\"agy.premium\"][1:]) == \"gemini-5-nova-high\"\n    assert \"gemini-5-nova-high\" not in F.unlisted_models(models, [\"nova\", \"argon\", \"flash\"])\nprint(\"ok\")"],"exit_code":0,"finished_at":"2026-10-17T09:04:20.719778Z","started_at":"2026-10-17T09:04:20.670268Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test-fleet-state.py"],"exit_code":0,"finished_at":"2026-10-17T09:04:34.044524Z","started_at":"2026-10-17T09:04:20.719838Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb