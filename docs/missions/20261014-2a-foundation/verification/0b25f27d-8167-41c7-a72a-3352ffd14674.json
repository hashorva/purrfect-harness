{"attempt":1,"commands":[{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","-c","import sys\nsys.path.insert(0, \"scripts\")\nimport drive_cli_rules as R\nws = \"/tmp/ws-exact\"\nrules = R.load_rules()\nok = R.match_pane(f\"Do you trust the files in this folder?\\n{ws}\\n[y/n] \", ws, rules)\nassert ok[\"decision\"] == \"answer\" and ok[\"rule_id\"] == \"folder_trust\" and ok[\"exit_code\"] is None, ok\nfor bad_ws in (\"/tmp/ws-exact-2\", \"/tmp/ws-exact/sub\", \"/tmp\", \"/tmp/ws-exact/../other\"):\n    r = R.match_pane(f\"Do you trust the files in this folder?\\n{bad_ws}\\n[y/n] \", ws, rules)\n    assert r[\"decision\"] == \"stop\" and r[\"category\"] == \"unknown_prompt\" and r[\"exit_code\"] == 3, (bad_ws, r)\nnever_cases = {\n    \"write_outside_workspace\": \"Allow write to /etc/hosts? [y/n]\",\n    \"delete_ignored_files\": \"Run git clean -fdX to delete ignored files? [y/n]\",\n    \"push_network_install\": \"Allow git push origin main? [y/n]\",\n    \"git_history_changes\": \"Run git reset --hard HEAD~1? [y/n]\",\n    \"credits_payment\": \"Purchase $20 API credits now? [y/n]\",\n}\nfor rid, prompt in never_cases.items():\n    r = R.match_pane(prompt, ws, rules)\n    assert r[\"decision\"] == \"stop\" and r[\"category\"] == \"never\" and r[\"rule_id\"] == rid and r[\"exit_code\"] == 3, (rid, r)\nunk = R.match_pane(\"Enable telemetry uploads? [y/n]\", ws, rules)\nassert unk[\"decision\"] == \"stop\" and unk[\"category\"] == \"unknown_prompt\" and unk[\"exit_code\"] == 3, unk\nwait = R.match_pane(\"Compiling project... 42%\", ws, rules)\nassert wait[\"decision\"] == \"wait\" and wait[\"exit_code\"] is None, wait\nprint(\"ok\")"],"exit_code":0,"finished_at":"2026-10-17T09:41:51.447911Z","started_at":"2026-10-17T09:41:51.420224Z","stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"dc51b8c96c2d745df3bd5590d990230a482fd247123599548e0632fdbf97fc22"},{"argv":["env","PYTHONDONTWRITEBYTECODE=1","python3","tests/test